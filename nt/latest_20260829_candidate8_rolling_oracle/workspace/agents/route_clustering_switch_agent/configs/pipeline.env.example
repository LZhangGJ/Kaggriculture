# Copy this file outside the bundle, edit the input paths, then pass it to
# scripts/run_pipeline.sh. Replay files and generated results remain outside
# this source-only bundle.
REPLAY_MANIFEST=/data/replays/latest/manifest.json
REPLAY_ROOT=/data/replays/latest

# Optional second Replay collection. Set both variables or leave both unset.
# EXTRA_REPLAY_MANIFEST=/data/replays/older/manifest.json
# EXTRA_REPLAY_ROOT=/data/replays/older

# All generated caches, matrices, trees and exported runtime assets go here.
OUTPUT_ROOT=/data/experiments/macro-route-unified-20260825

PYTHON_BIN=python
FEATURE_WORKERS=12
AUDIT_WORKERS=96
TREE_WORKERS=14

# Optional overrides. If omitted, all Nash-support routes enter switch search
# and the first support route is used for sequence search/final holdout.
# For the original 2026-08-25 experiment these were:
# OPENING_FAMILIES=G001,G136
# FINAL_OPENING=G001
