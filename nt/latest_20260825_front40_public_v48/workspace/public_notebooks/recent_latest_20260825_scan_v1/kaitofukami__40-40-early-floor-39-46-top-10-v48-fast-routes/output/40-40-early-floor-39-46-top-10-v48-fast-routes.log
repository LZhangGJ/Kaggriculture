,{"stream_name":"stdout","time":6.594836971,"data":"def _v48_package(name):\n"}
,{"stream_name":"stdout","time":6.594839851,"data":"    module = sys.modules.get(name)\n"}
,{"stream_name":"stdout","time":6.594842591,"data":"    if module is None:\n"}
,{"stream_name":"stdout","time":6.594845481,"data":"        module = types.ModuleType(name)\n"}
,{"stream_name":"stdout","time":6.594848391,"data":"        module.__file__ = \"\u003cbundled-package:\" + name + \"\u003e\"\n"}
,{"stream_name":"stdout","time":6.594851881,"data":"        module.__package__ = name\n"}
,{"stream_name":"stdout","time":6.594865731,"data":"        module.__path__ = []\n"}
,{"stream_name":"stdout","time":6.594869661,"data":"        sys.modules[name] = module\n"}
,{"stream_name":"stdout","time":6.594873051,"data":"    return module\n"}
,{"stream_name":"stdout","time":6.594876451,"data":"\n"}
,{"stream_name":"stdout","time":6.594879611,"data":"\n"}
,{"stream_name":"stdout","time":6.594882841,"data":"def _v48_load(name, source):\n"}
,{"stream_name":"stdout","time":6.594886081,"data":"    parent, _, child = name.rpartition(\".\")\n"}
,{"stream_name":"stdout","time":6.594889531,"data":"    if parent:\n"}
,{"stream_name":"stdout","time":6.594892622,"data":"        _v48_package(parent)\n"}
,{"stream_name":"stdout","time":6.594895911,"data":"    module = types.ModuleType(name)\n"}
,{"stream_name":"stdout","time":6.594898762,"data":"    module.__file__ = \"\u003cbundled:\" + name + \"\u003e\"\n"}
,{"stream_name":"stdout","time":6.594901922,"data":"    module.__package__ = parent\n"}
,{"stream_name":"stdout","time":6.594904822,"data":"    sys.modules[name] = module\n"}
,{"stream_name":"stdout","time":6.594907722,"data":"    exec(compile(source, module.__file__, \"exec\"), module.__dict__)\n"}
,{"stream_name":"stdout","time":6.594910791,"data":"    if parent:\n"}
,{"stream_name":"stdout","time":6.5949136710000005,"data":"        setattr(sys.modules[parent], child, module)\n"}
,{"stream_name":"stdout","time":6.594916582,"data":"    return module\n"}
,{"stream_name":"stdout","time":6.594919502,"data":"\n"}
