+  if(k>=9&&!keep.book[pos].funded&&keep.paths[pos].first_cost>0){
+   int paid=o.priv.shed[k];for(const auto&iv:o.priv.inventories)paid+=iv[k];
+   if(paid==0)removable.push_back(pos);
+  }
+ }
